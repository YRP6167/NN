X = [1 1;
     2 1;
     1 2;
     4 4;
     5 4;
     4 5];

T = [0;0;0;1;1;1];

runPerceptron(X,T);

fprintf('\nPerceptron training completed successfully.\n');

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
function runPerceptron(X,T)

W = [0 0];
b = 0;

learningRate = 1;
maxEpoch = 20;

for epoch = 1:maxEpoch

    errorCount = 0;

    for i = 1:size(X,1)

        net = X(i,:)*W' + b;

        if net >= 0
            output = 1;
        else
            output = 0;
        end

        error = T(i) - output;

        if error ~= 0
            W = W + learningRate*error*X(i,:);
            b = b + learningRate*error;
            errorCount = errorCount + 1;
        end

    end

    fprintf('Epoch %d : Error = %d\n',epoch,errorCount);

    if errorCount == 0
        break;
    end

end

fprintf('Final Weights:\n');
disp(W');

fprintf('Final Bias:\n');
disp(b);

fprintf('\n');

if max(X(:))<=1
    fprintf('X1  X2  Target  Output\n');
else
    fprintf('Input1 Input2 Target Output\n');
end

for i=1:size(X,1)

    net = X(i,:)*W' + b;

    if net>=0
        output=1;
    else
        output=0;
    end

    fprintf('%3d %6d %6d %7d\n',X(i,1),X(i,2),T(i),output);

end

fprintf('\n');

end
